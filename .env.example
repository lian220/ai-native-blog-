# Resend (이메일 발송)
# https://resend.com 에서 API 키 발급
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# 이메일 발신자 (Resend에서 도메인 인증 필요, 테스트용은 onboarding@resend.dev)
FROM_EMAIL=noreply@yourdomain.com

# 사이트 정보
NEXT_PUBLIC_SITE_URL=https://yourblog.com
NEXT_PUBLIC_SITE_NAME=My Blog

# 알림 API 인증 키 (랜덤 문자열 생성: openssl rand -hex 32)
NOTIFY_API_SECRET=your-secure-random-secret-key

# Vercel KV (Vercel 프로젝트 연동 시 자동 설정됨)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
